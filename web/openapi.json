nputBody_460594ef.json"],"format":"uri","readOnly":true,"type":"string"},"reason":{"type":"string"}},"required":["reason"],"type":"object"},"ReviewRequestChangesOutputBody_54d47f73":{"additionalProperties":false,"properties":{"$schema":{"description":"A URL to the JSON Schema for this object.","examples":["//schemas/ReviewRequestChangesOutputBody_54d47f73.json"],"format":"uri","readOnly":true,"type":"string"},"decision_id":{"format":"int64","type":"integer"},"run_id":{"type":"string"},"state":{"type":"string"}},"required":["run_id","state","decision_id"],"type":"object"},"Run":{"additionalProperties":false,"properties":{"agent_id":{"type":"string"},"completion_source":{"type":"string"},"contact_config_id":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"declared_at":{"format":"date-time","type":"string"},"declared_by":{"type":"string"},"device_id":{"type":"string"},"id":{"type":"string"},"manifest_hash":{"type":"string"},"meas_path":{"type":"string"},"measurement_type":{"type":"string"},"operator_comment":{"type":"string"},"sample_id":{"type":"string"},"state":{"type":"string"},"updated_at":{"format":"date-time","type":"string"}},"required":["id","manifest_hash","agent_id","measurement_type","completion_source","meas_path","operator_comment","state","declared_by","declared_at","created_at","updated_at"],"type":"object"},"RunFile":{"additionalProperties":false,"properties":{"bytes":{"format":"int64","type":"integer"},"created_at":{"format":"date-time","type":"string"},"id":{"format":"int64","type":"integer"},"name":{"type":"string"},"run_id":{"type":"string"},"sha256":{"type":"string"}},"required":["id","run_id","name","bytes","sha256","created_at"],"type":"object"},"RunStateTransition":{"additionalProperties":false,"properties":{"actor_id":{"type":"string"},"actor_type":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"from_state":{"type":"string"},"id":{"format":"int64","type":"integer"},"payload_json":{},"reason":{"type":"string"},"run_id":{"type":"string"},"to_state":{"type":"string"}},"required":["id","run_id","from_state","to_state","actor_type","actor_id","reason","created_at"],"type":"object"},"UserProfile":{"additionalProperties":false,"properties":{"display_name":{"type":"string"},"email":{"type":"string"},"global_role":{"type":"string"},"id":{"type":"string"}},"required":["id","email","display_name","global_role"],"type":"object"}}},"info":{"description":"REST API for the lab data management system: measurement-run ingest, the durable jobs queue, the run state machine, review/publish, and the browse/search catalog. Agents POST manifests; reviewers approve in the UI.\n\n## Authentication\n\nHuman endpoints require a JWT access token issued by `POST /v1/auth/login`, passed as `Authorization: Bearer \u003ctoken\u003e`. Measurement-PC agents authenticate to the ingest endpoints with a per-agent shared key (HMAC), not a JWT. Long-lived integrations may use a Personal Access Token (PAT).\n\n## Authorization\n\nHuman access is role-based (admin / pi / member) plus PAT scopes (`read:catalog`, `write:reviews`, …). Every mutation and every run state transition is recorded in an immutable audit trail.\n\n## Pagination\n\nList endpoints that support pagination use an opaque cursor scheme: the response includes a `next_cursor` field (empty string when no further pages exist). Pass `cursor=\u003cvalue\u003e` on the next request to advance the page. The `limit` parameter controls page size (defaults vary per endpoint; max 200).\n\n## Error envelope\n\nAll error responses share the shape `{\"code\": \"...\", \"message\": \"...\", \"details\": {...}}`. `code` is a stable machine-readable string (e.g. `run.not_found`, `precondition_failed`), `message` is human-readable, and `details` is optional structured context. The HTTP status carries the class.","title":"Lab Data Management API","version":"1.0.0"},"openapi":"3.1.0","paths":{"/v1/agents/manifest":{"post":{"description":"A measurement-PC agent POSTs the run manifest to declare completion. Authenticated with X-Agent-Id + X-Agent-Key. Idempotent on run_id: a duplicate POST returns the existing run without re-enqueuing work.","operationId":"agent-post-manifest","parameters":[{"description":"Agent identifier (matches agents.id)","in":"header","name":"X-Agent-Id","schema":{"description":"Agent identifier (matches agents.id)","type":"string"}},{"description":"Agent shared key","in":"header","name":"X-Agent-Key","schema":{"description":"Agent shared key","type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Manifest","description":"The run manifest (architecture §11)"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ManifestOutputBody_3f7000f3"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Declare a completed run (agent manifest POST)","tags":["ingest"]}},"/v1/auth/login":{"post":{"description":"Verifies email and password; returns a short-lived JWT access token.","operationId":"auth-login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthLoginInputBody_663e576b"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthLoginOutputBody_ece96b00"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Obtain an access token","tags":["auth"]}},"/v1/auth/me":{"get":{"description":"Returns the profile of the currently authenticated user.","operationId":"auth-me","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthMeOutputBody_1b20e166"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Current user profile","tags":["auth"]}},"/v1/auth/register":{"post":{"description":"Creates a new human reviewer account. In development the account is immediately active; in production it requires admin activation.","operationId":"auth-register","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthRegisterInputBody_3a2b514b"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthRegisterOutputBody_f5e4d292"}}},"description":"Created"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Register a new user account","tags":["auth"]}},"/v1/reviews":{"get":{"description":"Returns runs in state awaiting_review with their latest review_artifact summary.","operationId":"reviews-list","parameters":[{"explode":false,"in":"query","name":"limit","schema":{"format":"int64","type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewListOutputBody_9a2fb657"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"List runs awaiting review","tags":["reviews"]}},"/v1/reviews/{run_id}":{"get":{"description":"Returns the run, latest review_artifact, files, and transitions.","operationId":"reviews-get","parameters":[{"in":"path","name":"run_id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewGetOutputBody_b610a7a6"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Get review bundle","tags":["reviews"]}},"/v1/reviews/{run_id}/approve":{"post":{"description":"Transitions awaiting_review→approved, records decision, and enqueues publish_run.","operationId":"reviews-approve","parameters":[{"in":"path","name":"run_id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewApproveOutputBody_7d680067"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Approve a run","tags":["reviews"]}},"/v1/reviews/{run_id}/metadata":{"patch":{"description":"Identity/display correction (§9): updates runs.operator_comment without changing state.","operationId":"reviews-patch-metadata","parameters":[{"in":"path","name":"run_id","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewPatchMetadataInputBody_8af97060"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewPatchMetadataOutputBody_e4cbab6f"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Correct operator comment","tags":["reviews"]}},"/v1/reviews/{run_id}/quarantine":{"post":{"description":"Transitions awaiting_review→quarantined and records decision with reason.","operationId":"reviews-quarantine","parameters":[{"in":"path","name":"run_id","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewQuarantineInputBody_460594ef"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewQuarantineOutputBody_54d47f73"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Quarantine a run","tags":["reviews"]}},"/v1/reviews/{run_id}/request-changes":{"post":{"description":"Transitions awaiting_review→changes_requested