ing"},"declared_by":{"type":"string"},"device_id":{"type":"string"},"id":{"type":"string"},"manifest_hash":{"type":"string"},"meas_path":{"type":"string"},"measurement_type":{"type":"string"},"operator_comment":{"type":"string"},"sample_id":{"type":"string"},"state":{"type":"string"},"updated_at":{"format":"date-time","type":"string"}},"required":["id","manifest_hash","agent_id","measurement_type","completion_source","meas_path","operator_comment","state","declared_by","declared_at","created_at","updated_at"],"type":"object"},"RunFile":{"additionalProperties":false,"properties":{"bytes":{"format":"int64","type":"integer"},"created_at":{"format":"date-time","type":"string"},"id":{"format":"int64","type":"integer"},"name":{"type":"string"},"run_id":{"type":"string"},"sha256":{"type":"string"}},"required":["id","run_id","name","bytes","sha256","created_at"],"type":"object"},"RunStateTransition":{"additionalProperties":false,"properties":{"actor_id":{"type":"string"},"actor_type":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"from_state":{"type":"string"},"id":{"format":"int64","type":"integer"},"payload_json":{},"reason":{"type":"string"},"run_id":{"type":"string"},"to_state":{"type":"string"}},"required":["id","run_id","from_state","to_state","actor_type","actor_id","reason","created_at"],"type":"object"},"Sample":{"additionalProperties":false,"properties":{"created_at":{"format":"date-time","type":"string"},"dielectric":{},"fabrication_batch":{"type":"string"},"id":{"type":"string"},"material_stack":{"type":"string"},"notes":{"type":"string"},"params_json":{}},"required":["id","created_at"],"type":"object"},"UserProfile":{"additionalProperties":false,"properties":{"display_name":{"type":"string"},"email":{"type":"string"},"global_role":{"type":"string"},"id":{"type":"string"}},"required":["id","email","display_name","global_role"],"type":"object"}}},"info":{"description":"REST API for the lab data management system: measurement-run ingest, the durable jobs queue, the run state machine, review/publish, and the browse/search catalog. Agents POST manifests; reviewers approve in the UI.\n\n## Authentication\n\nHuman endpoints require a JWT access token issued by `POST /v1/auth/login`, passed as `Authorization: Bearer \u003ctoken\u003e`. Measurement-PC agents authenticate to the ingest endpoints with a per-agent shared key (HMAC), not a JWT. Long-lived integrations may use a Personal Access Token (PAT).\n\n## Authorization\n\nHuman access is role-based (admin / pi / member) plus PAT scopes (`read:catalog`, `write:reviews`, …). Every mutation and every run state transition is recorded in an immutable audit trail.\n\n## Pagination\n\nList endpoints that support pagination use an opaque cursor scheme: the response includes a `next_cursor` field (empty string when no further pages exist). Pass `cursor=\u003cvalue\u003e` on the next request to advance the page. The `limit` parameter controls page size (defaults vary per endpoint; max 200).\n\n## Error envelope\n\nAll error responses share the shape `{\"code\": \"...\", \"message\": \"...\", \"details\": {...}}`. `code` is a stable machine-readable string (e.g. `run.not_found`, `precondition_failed`), `message` is human-readable, and `details` is optional structured context. The HTTP status carries the class.","title":"Lab Data Management API","version":"1.0.0"},"openapi":"3.1.0","paths":{"/v1/admin/agents":{"get":{"description":"Returns all agents with their allowed roots. Requires admin or pi role.","operationId":"admin-list-agents","responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminListAgentsOutputBody_d8325375"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"List agents","tags":["admin"]},"post":{"description":"Creates a new agent and returns its raw key (shown ONCE). Requires admin role.","operationId":"admin-register-agent","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminRegisterAgentInputBody_e8917e1a"}}},"required":true},"responses":{"201":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminRegisterAgentOutputBody_a33cf55e"}}},"description":"Created"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Register a new agent","tags":["admin"]}},"/v1/admin/agents/{id}":{"patch":{"description":"Enables/disables an agent and/or replaces its allowed roots. Requires admin role.","operationId":"admin-patch-agent","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminPatchAgentInputBody_6dfd5883"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminPatchAgentOutputBody_8a981e73"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Update agent enabled flag or allowed roots","tags":["admin"]}},"/v1/admin/agents/{id}/rotate-key":{"post":{"description":"Generates and stores a new key for the agent; returns the raw key once. Requires admin role.","operationId":"admin-rotate-agent-key","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminRotateKeyOutputBody_c9525ea8"}}},"description":"OK"},"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorModel"}}},"description":"Error"}},"summary":"Rotate an agent key","tags":["admin"]}},"/v1/admin/audit":{"get":{"description":"Read-only audit log of state transitions, optionally filtered by run_id. Requires admin or pi role.","operationId":"admin-list-audit","parameters"