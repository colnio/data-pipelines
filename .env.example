# Copy to .env and fill blanks. The same loader reads a sealed .env in prod;
# only endpoints/secrets differ between dev and prod.

APP_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173

# --- Database (Postgres 16; docker-compose locally) ---
# The dev stack shares a local Postgres; this project uses its own database.
DATABASE_URL=postgres://lab:lab@localhost:5432/labdata?sslmode=disable
# Used by Go integration tests (skip cleanly when unset/unreachable).
TEST_DATABASE_URL=postgres://lab:lab@localhost:5432/labdata_test?sslmode=disable

# --- On-disk data store (architecture §5) ---
# raw/ is immutable & write-once after promotion; published/ is append-only.
LABDATA_ROOT=/srv/labdata
# Defaults to <LABDATA_ROOT>/staging if unset.
LABDATA_STAGING_ROOT=

# --- Agent transfer (architecture §13) ---
MAX_CONCURRENT_PULLS=2
PULL_TIMEOUT=30m
MAX_ARCHIVE_BYTES=53687091200   # 50 GiB

# --- Auth signing + cookies (human reviewers) ---
JWT_SIGNING_KEY=dev-insecure-jwt-key-change-me
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ALLOWED_EMAIL_DOMAINS=nus.edu.sg,u.nus.edu

# --- Notifications (architecture §21) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@lab.local
TELEGRAM_BOT_TOKEN=

# --- Scheduling ---
LAB_TIMEZONE=Asia/Singapore
